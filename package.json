{
  "name": "almanac",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "codegen:api": "pnpm --filter @almanac/api-client generate",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "oxlint && oxfmt --check && pnpm -r typecheck && pnpm -r test"
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.11.0"
}
