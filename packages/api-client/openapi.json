{
  "openapi": "3.1.0",
  "info": {
    "title": "Almanac API",
    "version": "0.0.1"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "operationId": "health.check",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ok"]
                    }
                  },
                  "required": ["status"],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": ["users"],
        "operationId": "users.me",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "User",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserEncoded"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded"
                }
              }
            }
          }
        }
      }
    },
    "/journal/entries": {
      "get": {
        "tags": ["journal"],
        "operationId": "journal.list",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JournalEntrySummaryEncoded"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded"
                }
              }
            }
          }
        }
      }
    },
    "/journal/entries/{date}": {
      "get": {
        "tags": ["journal"],
        "operationId": "journal.get",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/JournalEntrySnapshotEncoded"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UnauthorizedEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["Unauthorized"]
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["_tag", "message"],
        "additionalProperties": false
      },
      "JournalEntrySnapshotEncoded": {
        "type": "object",
        "properties": {
          "doc": {
            "type": "string",
            "format": "byte",
            "contentEncoding": "base64"
          },
          "body": {
            "type": "string"
          }
        },
        "required": ["doc", "body"],
        "additionalProperties": false
      },
      "JournalEntrySummaryEncoded": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "preview": {
            "type": "string"
          }
        },
        "required": ["id", "date", "preview"],
        "additionalProperties": false
      },
      "UserEncoded": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          }
        },
        "required": ["id", "email", "name", "emailVerified"],
        "additionalProperties": false
      }
    },
    "securitySchemes": {}
  },
  "security": [],
  "tags": [
    {
      "name": "health"
    },
    {
      "name": "users"
    },
    {
      "name": "journal"
    }
  ]
}
